# Copy to .env — or just use the "Trading credentials" panel in the dashboard,
# which writes this file for you. .env is gitignored; never commit it.

# ---------------------------------------------------------------------------
# Wallet (signs CLOB orders locally; never leaves this machine)
# ---------------------------------------------------------------------------
POLY_PRIVATE_KEY=
# Optional. If set, saving fails unless POLY_PRIVATE_KEY derives this address.
POLY_WALLET_ADDRESS=
# Polymarket proxy/funder address holding the pUSD (Polymarket UI wallet).
# Leave blank if you trade directly from the EOA above.
POLY_FUNDER_ADDRESS=
# Signature type: 0 = EOA, 1 = legacy email proxy, 2 = legacy Safe,
# 3 = CLOB V2 deposit wallet (EIP-1271).
POLY_SIGNATURE_TYPE=0

# ---------------------------------------------------------------------------
# CLOB L2 API credentials (derive from the key, or paste pre-derived ones)
# ---------------------------------------------------------------------------
# Written as 2 only after the dashboard verifies the credentials against V2.
# Do not set this by hand.
POLY_CLOB_VERSION=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Chainlink Data Streams — the source these markets actually resolve against.
#
# Optional but strongly recommended: with it, anchors, volatility and
# settlement all use the venue's own series instead of a Coinbase/Kraken proxy,
# removing the basis error. Read-only market data; cannot move funds.
# Enter these in the dashboard (Runtime & keys) rather than by hand if you
# prefer — it validates them against the API before saving.
# ---------------------------------------------------------------------------
CHAINLINK_API_KEY=
CHAINLINK_API_SECRET=

# ---------------------------------------------------------------------------
# Live trading master switch.
#
# Paper trading needs NONE of the above and ignores this flag entirely.
# Set to 1 ONLY when you intend to spend real pUSD. The live order path in
# this build has never been executed against real funds — read LIVE_TRADING.md
# before flipping it.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
POLYBOT_HOST=127.0.0.1
POLYBOT_PORT=8848
